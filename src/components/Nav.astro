---
import Sigil from './Sigil.astro';
import { nav } from '../data/site.js';
const { pathname } = Astro.url;
const current = (href) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="nav" id="site-nav">
  <div class="nav__inner">
    <a href="/" class="nav__mark" aria-label="Aevum, home">
      <Sigil class="nav__sigil" />
      <span class="nav__wordmark">Aevum</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {nav.map((item) => (
        <a
          href={item.href}
          class="nav__link"
          aria-current={current(item.href) ? 'page' : undefined}
        >{item.label}</a>
      ))}
    </nav>

    <a href="/contact" class="btn nav__cta">Enquire</a>

    <button
      class="nav__toggle"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="nav-drawer"
      aria-label="Open menu"
    >
      <span class="nav__toggle-line"></span>
      <span class="nav__toggle-line"></span>
    </button>
  </div>
</header>

<div class="drawer" id="nav-drawer" aria-hidden="true">
  <nav class="drawer__links" aria-label="Menu">
    {nav.map((item, i) => (
      <a
        href={item.href}
        class="drawer__link"
        style={`--i: ${i}`}
        aria-current={current(item.href) ? 'page' : undefined}
      ><span class="split-line"><span class="split-inner">{item.label}</span></span></a>
    ))}
  </nav>
  <a href="/contact" class="btn btn--solid drawer__cta" style="--i: 4">Enquire</a>
</div>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 1000;
    transition:
      transform 0.6s var(--ease-out),
      background-color 0.45s var(--ease-out),
      border-color 0.45s var(--ease-out);
    border-bottom: 1px solid transparent;
  }
  /* A soft scrim rather than a hard bar: opaque behind the links, fading out
     well below them, so copy scrolling underneath never collides with the nav
     but there is no visible edge either. */
  .nav::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 190%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.45s var(--ease-out);
    /* Masked so the blur fades out at the bottom instead of ending on a hard
       edge, which is what makes a blurred bar read as a pane of glass rather
       than a rectangle stuck to the top of the page. */
    mask-image: linear-gradient(#000 0%, #000 55%, rgba(0, 0, 0, 0.55) 78%, transparent 100%);
    background: linear-gradient(
      rgba(7, 21, 16, 0.72) 0%,
      rgba(7, 21, 16, 0.6) 45%,
      rgba(7, 21, 16, 0.3) 72%,
      transparent 100%
    );
  }

  /* The blur is attached only once the bar is solid. It is the single place on
     this site allowed to use backdrop-filter: over a live WebGL canvas the
     filter re-samples its backdrop every frame, so it is confined to this one
     short strip and is off entirely while the page sits at the top. */
  .nav.is-solid::before {
    backdrop-filter: blur(16px) saturate(1.15);
    -webkit-backdrop-filter: blur(16px) saturate(1.15);
  }
  .nav.is-solid::before { opacity: 1; }
  /* the scrim is taller than the bar, so hiding the nav alone would leave a
     band of it on screen, so fade it with the same motion */
  .nav.is-hidden::before { opacity: 0; }
  .nav__inner { position: relative; }
  .nav.is-hidden { transform: translateY(-100%); }

  .nav__inner {
    width: min(100% - 2 * var(--gutter), var(--container));
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-block: 1.15rem;
  }

  .nav__mark {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--ivory);
  }
  :global(.nav__sigil) { width: 1.5rem; color: var(--gold); }
  .nav__wordmark {
    font-family: var(--font-display);
    font-size: 1.35rem;
    letter-spacing: 0.3em;
    text-indent: 0.05em;
    text-transform: uppercase;
    translate: 0 0.05em;
  }

  .nav__links {
    display: flex;
    gap: clamp(1.5rem, 3vw, 2.75rem);
    margin-left: auto;
  }
  .nav__link {
    position: relative;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    padding: 0.5rem 0;
    transition: color 0.35s var(--ease-out);
  }
  .nav__link::after {
    content: "";
    position: absolute;
    left: 0; bottom: 0.15rem;
    width: 100%; height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease-out);
  }
  .nav__link:hover, .nav__link[aria-current="page"] { color: var(--ivory); }
  .nav__link:hover::after, .nav__link[aria-current="page"]::after { transform: scaleX(1); }

  .nav__cta { padding: 0.7rem 1.6rem; }

  .nav__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 7px;
    width: 44px; height: 44px;
    margin-left: auto;
    align-items: center;
  }
  .nav__toggle-line {
    width: 26px; height: 1.5px;
    background: var(--ivory);
    transition: transform 0.45s var(--ease-out), opacity 0.3s;
  }
  .nav__toggle[aria-expanded="true"] .nav__toggle-line:first-child {
    transform: translateY(4.25px) rotate(45deg);
  }
  .nav__toggle[aria-expanded="true"] .nav__toggle-line:last-child {
    transform: translateY(-4.25px) rotate(-45deg);
  }

  .drawer {
    position: fixed;
    inset: 0;
    z-index: 900;
    background: var(--forest-975);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--gutter);
    gap: 3rem;
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    transition:
      clip-path 0.7s var(--ease-out),
      visibility 0s 0.7s;
  }
  .drawer.is-open {
    clip-path: inset(0 0 0% 0);
    visibility: visible;
    transition: clip-path 0.7s var(--ease-out);
  }
  .drawer__links { display: flex; flex-direction: column; gap: 0.5rem; }
  .drawer__link {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 9vw, 3.4rem);
    color: var(--ivory);
    line-height: 1.25;
  }
  .drawer__link[aria-current="page"] { color: var(--gold); }
  /* The drawer runs its own entrance, independent of the page reveal system.
     It needs its own transition: the shared one moved to Motion. */
  .drawer .split-inner {
    transition: transform 0.7s var(--ease-out);
    transition-delay: calc(0.12s + var(--i) * 0.06s);
  }
  .drawer:not(.is-open) .split-inner { transform: translateY(110%); transition-delay: 0s; }
  /* The drawer's own open state. It used to borrow `.in` from the page reveal
     system, which no longer reaches the persisted nav. */
  .drawer.is-open .split-inner { transform: translateY(0); }
  .drawer__cta { align-self: flex-start; }

  @media (max-width: 860px) {
    .nav__links, .nav__cta { display: none; }
    .nav__toggle { display: flex; }
  }

  /* The nav is the site's one glass surface. HIG liquid glass checklist:
     "Reduce Transparency gets an opaque fallback, Increase Contrast gets
     stronger fills and borders." With either set, the scrim becomes a solid
     bar the height of the nav, no blur, no fade-out. */
  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
    .nav.is-solid::before {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      background: var(--forest-975);
      mask-image: none;
      height: 100%;
    }
    .nav.is-solid { border-bottom-color: var(--line); }
  }
</style>
