---
import Sigil from './Sigil.astro';
import { site, contact, nav } from '../data/site.js';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__ident">
        <Sigil class="footer__sigil" />
        <p class="footer__wordmark">Aevum</p>
        <p class="footer__strap">{site.tagline}</p>
      </div>

      <div class="footer__col">
        <p class="footer__heading">Navigate</p>
        <ul class="footer__list">
          {nav.map((item) => (
            <li><a class="footer__link" href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer__col">
        <p class="footer__heading">Reach us</p>
        <ul class="footer__list">
          <li><a class="footer__link" href={`mailto:${contact.email}`}>{contact.email}</a></li>
          {contact.phone && (
            <li><a class="footer__link" href={contact.phoneHref}>{contact.phone}</a></li>
          )}
          {contact.address.map((line) => (
            <li class="footer__addr">{line}</li>
          ))}
        </ul>
      </div>
    </div>

    <hr class="rule" />

    <div class="footer__base">
      <p>© {year} {site.legalName}. All rights reserved.</p>
      <div class="footer__legal">
        <a class="footer__link" href="/privacy">Privacy Policy</a>
        <a class="footer__link" href="/terms">Terms of Use</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--forest-975);
    padding-block: clamp(4rem, 8vw, 7rem) 2.5rem;
    color: var(--text-dim);
    font-size: var(--size-small);
  }
  .footer__top {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  :global(.footer__sigil) { width: 1.9rem; color: var(--gold); margin-bottom: 1.4rem; }
  .footer__wordmark {
    font-family: var(--font-display);
    font-size: 1.6rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ivory);
    margin-bottom: 1rem;
  }
  .footer__strap { max-width: 30ch; line-height: 1.7; }
  .footer__heading {
    font-family: var(--font-display);
    font-size: var(--size-micro);
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-dim); /* a label; gold is reserved for links */
    margin-bottom: 1.4rem;
  }
  .footer__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .footer__link {
    color: var(--text-dim);
    transition: color 0.35s var(--ease-out);
  }
  .footer__link:hover { color: var(--gold-bright); }
  .footer__addr { color: var(--text-faint); }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 2.2rem;
    font-size: var(--size-micro);
    color: var(--text-faint);
  }
  .footer__legal { display: flex; gap: 2rem; }

  @media (max-width: 760px) {
    .footer__top { grid-template-columns: 1fr; gap: 3rem; }
  }
</style>
