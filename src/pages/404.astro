---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Aevum" description="This page does not exist.">
  <section class="nf" data-cam="approach">
    <div class="container">
      <p class="nf__code display">404</p>
      <h1 data-reveal>This page has eroded away.</h1>
      <p class="lede" data-reveal style="--reveal-delay: 0.1s">
        The address you followed does not exist, or does not exist any more.
      </p>
      <a href="/" class="btn" data-reveal style="--reveal-delay: 0.2s">Back to the start</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 100dvh;
    display: flex;
    align-items: center;
    padding-block: clamp(8rem, 20vh, 12rem);
  }
  .nf .container {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.8rem;
  }
  .nf__code {
    font-size: clamp(5rem, 16vw, 11rem);
    color: var(--forest-700);
    line-height: 1;
  }
</style>
